{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(npm publish:*)",
      "Bash(npm login:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(yarn npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(twine:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(//home/deeumiya/mealie-wf2/frontend/**)",
      "Edit(//home/deeumiya/mealie-wf2/mealie/**)",
      "Edit(//home/deeumiya/mealie-wf2/frontend-e2e/**)",
      "Edit(//home/deeumiya/mealie-wf2/rewrite-evidence/measure.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wf2_guard_paths.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wf2_post_edit.py",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wf2_stop_gate.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
